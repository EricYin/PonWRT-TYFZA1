#include "rtl9617c-tyfza1-dma-tx.dts"
#include <dt-bindings/gpio/gpio.h>
#include "rtl9617c-tyfza1-leds.dtsi"

/ { model = "Tianyi TYFZA1 (native NI/DMA bring-up)"; };

&{/soc/ethernet@4f4300000} {
	reg = <4 0xf4300000 0 0x10000>, <0 0xf4500000 0 0x2000>,
	      <4 0xf7001000 0 0x1000>, <4 0xf432d000 0 0x1000>,
	      <4 0xf4320098 0 4>, <4 0xf432f000 0 0x1000>;
	reg-names = "ni", "xram", "dma-lso", "qm-axi-reorder", "block-reset",
		    "l3fe-axi-reorder";
	realtek,qm-rx;
	/* PT1570-R10: the panel is silkscreened LAN1..LAN4 left to right, but the
	 * PHY order is reversed (phy0 drives panel LAN4). Reversing both lists
	 * makes Linux lan1 = panel LAN1, which matches the labels and the LEDs.
	 *
	 * Careful: rtl_register_lans() reads realtek,lan-phys with index == port,
	 * and port 0 does NOT use lan-phys at all - it uses phy-handle. So
	 * lan-phys[0] is never read, and phy-handle has to be reversed too,
	 * otherwise port 0 and port 3 both end up on phy0 (mdio:01) and the
	 * second phy_attach_direct() fails with -EEXIST:
	 *   sysfs: cannot create duplicate filename
	 *   '/bus/mdio_bus/drivers/Generic PHY/4f4329118.mdio:01'
	 *
	 * Final mapping (port -> phy -> panel):
	 *   port 0 -> phy-handle phy3 (mdio:04) -> LAN1
	 *   port 1 -> lan-phys[1] phy2 (mdio:03) -> LAN2
	 *   port 2 -> lan-phys[2] phy1 (mdio:02) -> LAN3
	 *   port 3 -> lan-phys[3] phy0 (mdio:01) -> LAN4
	 */
	phy-handle = <&phy3>;
	realtek,lan-phys = <&phy3 &phy2 &phy1 &phy0>;
	interrupts = <GIC_SPI 84 IRQ_TYPE_LEVEL_HIGH>;
};

&{/soc} {
	gpio0: gpio@4f43292c0 {
		compatible = "realtek,rtl9617c-gpio";
		reg = <4 0xf43292c0 0 0xb4>;
		gpio-controller;
		#gpio-cells = <2>;
		gpio-ranges = <&pinctrl 0 0 160>;
	};
};
