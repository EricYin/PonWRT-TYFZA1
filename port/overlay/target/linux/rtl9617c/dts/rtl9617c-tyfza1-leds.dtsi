// Stock boot selects conf-1/fdt@1: f85b7a420a14fa31ece8a1e6f7e426f2a464587cf8ad19ce88932a4b7903d050.
#include <dt-bindings/input/input.h>
/ {
	aliases {
		led-boot = &led_power;
		led-failsafe = &led_power;
		led-running = &led_power;
		led-upgrade = &led_power;
		led-wps = &led_wps;
	};

	leds {
		compatible = "tianyi,tyfza1-leds";
		internet { label = "LED_PPP_G"; gpios = <&gpio0 2 GPIO_ACTIVE_LOW>; };
		los { label = "LED_LOS"; gpios = <&gpio0 10 GPIO_ACTIVE_LOW>; };
		usb0 { label = "LED_USB0"; gpios = <&gpio0 7 GPIO_ACTIVE_HIGH>; };
		pon { label = "LED_PON"; gpios = <&gpio0 9 GPIO_ACTIVE_LOW>; };
		led_power: power { label = "LED_PWR_G"; gpios = <&gpio0 11 GPIO_ACTIVE_HIGH>; default-state = "on"; };
		phone { label = "LED_FXS"; gpios = <&gpio0 12 GPIO_ACTIVE_HIGH>; };
		lan0 { label = "LED_EPHY0"; gpios = <&gpio0 4 GPIO_ACTIVE_LOW>; };
		lan1 { label = "LED_EPHY1"; gpios = <&gpio0 3 GPIO_ACTIVE_LOW>; };
		lan2 { label = "LED_EPHY2"; gpios = <&gpio0 1 GPIO_ACTIVE_LOW>; };
		lan3 { label = "LED_EPHY3"; gpios = <&gpio0 0 GPIO_ACTIVE_LOW>; };
		usb1 { label = "LED_USB1"; gpios = <&gpio0 6 GPIO_ACTIVE_LOW>; };
		led_wps: wps { label = "LED_WPS_G"; gpios = <&gpio0 5 GPIO_ACTIVE_HIGH>; };
	};

	/*
	 * PT1570-R10 carries three front-panel keys. GPIO numbers were established
	 * by dumping the raw input registers from U-Boot while pressing each key:
	 *   reset  -> bank0 pin8  = 8
	 *   lights -> bank3 pin3  = 99
	 *   wifi   -> bank3 pin7  = 103
	 * The stock FDT labels these as <&gpio2 7> / <&gpio2 3>, but that phandle
	 * actually resolves to bank@3 (node name and range index are off by one),
	 * which is why reading bank2 always returned zero.
	 *
	 * The stock node used "gpio-keys" (interrupt driven); polling is kept here
	 * because the native GPIO driver does not wire up the bank interrupts.
	 */
	led-button {
		compatible = "gpio-keys-polled";
		poll-interval = <20>;

		btn-reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&gpio0 8 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};
		btn-led {
			label = "lights_toggle";
			linux,code = <KEY_LIGHTS_TOGGLE>;
			gpios = <&gpio0 103 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};
		btn-wifi {
			label = "wifi";
			linux,code = <KEY_WPS_BUTTON>;
			gpios = <&gpio0 99 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};
	};
};
