# ============================================================
# PonWRT-TYFZA1 合并版配置 = 你的全部自定义 + 上游 v0.8.0-beta（ceeff96）
# （合入上游 ceeff96 时，直接用本文件覆盖 port/configs/tyfza1-boot.config）
#
# ★ 相对 v0.7 合并版的变化：
#   1. 新增 CONFIG_SIGNED_PACKAGES=y / CONFIG_SIGN_EACH_PACKAGE=y（上游默认，
#      官方 APK 软件源安装需要签名包，建议保留）
#   2. 新增 port/configs/tyfza1-compat.config 要求的 33 个 CONFIG_PACKAGE_*=y
#      —— build.sh 在 make defconfig 后会逐行硬检查它们都在 .config 里，
#      缺一个构建直接失败。这 33 行已全部并入本文件。
#   3. VERSION_NUMBER 由 sync-overlay.sh 用 VERSION 文件重写，写任意值均可
#
# ★ .config 语法速查：
#   顶格   CONFIG_PACKAGE_x=y               → 启用
#   顶格   # CONFIG_PACKAGE_x is not set    → 显式禁用（kconfig 标准禁用写法）
#   任何以 # 开头的其他形式 → 纯注释，按默认值
# ============================================================

# ---------------- 基础配置（上游 v0.8.0-beta 基线） ----------------
CONFIG_TARGET_rtl9617c=y
CONFIG_TARGET_rtl9617c_generic=y
CONFIG_TARGET_rtl9617c_generic_DEVICE_tianyi_tyfza1=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_INITRAMFS_COMPRESSION_GZIP=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_TARGZ=y
CONFIG_PACKAGE_ubi-utils=y
CONFIG_PACKAGE_nand-utils=y
CONFIG_PACKAGE_uboot-envtools=y
CONFIG_PACKAGE_kmod-rtl-ax-ap=y
CONFIG_KERNEL_IKCONFIG=y
CONFIG_KERNEL_IKCONFIG_PROC=y
# CONFIG_KERNEL_KALLSYMS_EXTRA_PASS is not set
# CONFIG_TARGET_ROOTFS_EXT4FS is not set
# CONFIG_TARGET_ROOTFS_UBIFS is not set
# 上游 v0.8.0-beta 起启用包签名（官方 APK 源安装所需，勿删）
CONFIG_SIGNED_PACKAGES=y
CONFIG_SIGN_EACH_PACKAGE=y
CONFIG_PACKAGE_dnsmasq-full=y
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_luci=y
# 上游 v0.7.0：简体中文 + Argon 主题（build.sh 硬检查，勿删）
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_luci-app-tyfza1-pon=y
CONFIG_PACKAGE_tyfza1-pon-control=y
CONFIG_PACKAGE_kmod-ipt-offload=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_wpad-mbedtls=y
CONFIG_PACKAGE_wifi-scripts=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_wireless-regdb=y
CONFIG_IMAGEOPT=y
CONFIG_VERSIONOPT=y
CONFIG_VERSION_NUMBER="0.8.1-beta"
# CONFIG_VERSION_FILENAMES is not set
# CONFIG_VERSION_CODE_FILENAMES is not set

# ============================================================
# 上游 tyfza1-compat.config 强制清单（build.sh 逐行硬检查，勿删）
# 官方 A53 APK 源 + 常用插件内核模块与依赖
# ============================================================
CONFIG_PACKAGE_openwrt-keyring=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_libatomic=y
CONFIG_PACKAGE_libstdcpp=y
CONFIG_PACKAGE_libpthread=y
CONFIG_PACKAGE_librt=y

# VPN 依赖
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_kmod-ovpn-backports=y

# SQM 与流量统计
CONFIG_PACKAGE_kmod-ifb=y
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-sched-cake=y
CONFIG_PACKAGE_kmod-sched-connmark=y
CONFIG_PACKAGE_kmod-sched-ctinfo=y
CONFIG_PACKAGE_kmod-nf-conntrack-netlink=y
CONFIG_PACKAGE_kmod-inet-diag=y

# nftables / iptables 透明代理与多 WAN 规则
CONFIG_PACKAGE_iptables-nft=y
CONFIG_PACKAGE_ip6tables-nft=y
CONFIG_PACKAGE_iptables-mod-conntrack-extra=y
CONFIG_PACKAGE_iptables-mod-ipopt=y
CONFIG_PACKAGE_iptables-mod-tproxy=y
CONFIG_PACKAGE_iptables-mod-socket=y
CONFIG_PACKAGE_ip6tables-mod-nat=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-compat=y
CONFIG_PACKAGE_kmod-nft-queue=y
CONFIG_PACKAGE_kmod-ipt-ipset=y
CONFIG_PACKAGE_kmod-ipt-ipopt=y
CONFIG_PACKAGE_kmod-ipt-conntrack=y
CONFIG_PACKAGE_kmod-ipt-conntrack-extra=y
CONFIG_PACKAGE_kmod-ipt-tproxy=y
CONFIG_PACKAGE_kmod-ipt-nat=y
CONFIG_PACKAGE_kmod-ip6tables=y
CONFIG_PACKAGE_kmod-ipt-nat6=y

# ---------------- WireGuard（自用） ----------------
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y

# ---------------- iperf3（自用） ----------------
CONFIG_PACKAGE_iperf3=y

# ---------------- SmartDNS（自用） ----------------
CONFIG_PACKAGE_smartdns=y
CONFIG_PACKAGE_luci-app-smartdns=y
CONFIG_PACKAGE_luci-i18n-smartdns-zh-cn=y

# ---------------- 多 Wan 分流（mwan3） ----------------
# 依赖的 iptables 由 compat 的 iptables-nft 提供（PROVIDES:=iptables），
# ipset/ip/ip6tables/iptables-mod-conntrack-extra/iptables-mod-ipopt 也已在 compat 清单
CONFIG_PACKAGE_jshn=y
CONFIG_PACKAGE_rpcd-mod-ucode=y
CONFIG_PACKAGE_mwan3=y
CONFIG_PACKAGE_luci-app-mwan3=y
CONFIG_PACKAGE_luci-i18n-mwan3-zh-cn=y
# dl12345/mwan3 nftables 移植版依赖（core 包，显式声明确保 feeds install 覆盖）
CONFIG_PACKAGE_libnetfilter-conntrack=y
CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_ucode=y
CONFIG_PACKAGE_ucode-mod-rtnl=y
CONFIG_PACKAGE_ucode-mod-uloop=y
CONFIG_PACKAGE_ucode-mod-uci=y
CONFIG_PACKAGE_ucode-mod-ubus=y
CONFIG_PACKAGE_ucode-mod-fs=y
CONFIG_PACKAGE_ucode-mod-socket=y
CONFIG_PACKAGE_ucode-mod-log=y

# ---------------- PassWall 依赖（自用） ----------------
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ipset=y
# nftables-json 变体（dl12345/mwan3 需要；与 nojson 互斥，替换基础配置的 nftables）
CONFIG_PACKAGE_nftables-json=y

# ---------------- PassWall 本体（自用） ----------------
# xray-core 与 INCLUDE_Xray 成对操作，同一符号只保留一种写法：
CONFIG_PACKAGE_xray-core=y
# sing-box 暂时出镜像：rootfs 超限 1.79 MiB（详见合入0.8操作指南），
# 如后续要加回：删掉下方 INCLUDE_SingBox 禁用行 + 新增 CONFIG_PACKAGE_sing-box=y
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-i18n-passwall-zh-cn=y

# ---------------- PassWall 组件开关 ----------------
# Xray / Nftables 透明代理保持默认开启；其余组件用禁用写法关闭：
# CONFIG_PACKAGE_luci-app-passwall_Iptables_Transparent_Proxy is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SingBox is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Haproxy is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Geoview is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Plugin is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray_Plugin is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Client is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Server is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_ShadowsocksR_Libev_Client is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_ShadowsocksR_Libev_Server is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Simple_Obfs is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_NaiveProxy is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Hysteria is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadow_TLS is not set
