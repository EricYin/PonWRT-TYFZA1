#!/bin/sh
[ "$ACTION" = "released" ] || exit 0

# Record every release with its hold time. Without this a "the key does
# nothing" report is ambiguous: it could be that the hotplug module never saw
# the press, or that the script ran and decided to skip.
logger -t wifi-button "released seen=${SEEN:-?}"

stamp=/tmp/.wifi-button.stamp
now=$(date +%s)
if [ -f "$stamp" ]; then
	last=$(cat "$stamp" 2>/dev/null)
	if [ -n "$last" ] && [ $((now - last)) -lt 3 ]; then
		logger -t wifi-button "debounced (${last})"
		exit 0
	fi
fi
echo "$now" > "$stamp"

# Serialise: a reload left running from the previous press would otherwise
# fight with this one.
exec 9>/tmp/.wifi-button.lock
flock -n 9 || { logger -t wifi-button "busy, ignored"; exit 0; }

if iw dev 2>/dev/null | grep -q 'Interface'; then
	target=1
else
	target=0
fi

i=0
while uci -q get "wireless.@wifi-device[$i]" >/dev/null 2>&1; do
	uci set "wireless.@wifi-device[$i].disabled=$target"
	i=$((i + 1))
done
uci commit wireless
logger -t wifi-button "radios disabled=$target"

if [ "$target" = "1" ]; then
	wifi down >/dev/null 2>&1
else
	wifi up >/dev/null 2>&1
fi
