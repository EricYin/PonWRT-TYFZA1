#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
#
# PT1570-R10 front-panel "wireless" key.
#
# The stock firmware uses this key for WPS, but this firmware ships a basic
# wpad without WPS support, so the key had no effect at all. Treating it as a
# radio on/off switch is both more useful and more predictable: press once to
# disable every radio, press again to bring them back.
#
# `wifi reload` restarts hostapd, so pressing it twice in a row is also the
# quickest way to bounce the APs without a reboot.

[ "$ACTION" = "released" ] || exit 0

current=$(uci -q get wireless.@wifi-device[0].disabled)
[ "$current" = "1" ] && target=0 || target=1

i=0
while uci -q get "wireless.@wifi-device[$i]" >/dev/null 2>&1; do
	uci set "wireless.@wifi-device[$i].disabled=$target"
	i=$((i + 1))
done

uci commit wireless
wifi reload
logger -t wifi-button "wireless radios disabled=$target"
