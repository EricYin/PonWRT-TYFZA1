# ============================================================
# PonWRT-TYFZA1 自定义软件包配置
# 用途：工作流 config_file 输入 / TYFZA1_CONFIG 环境变量传入
# 基于 port/configs/tyfza1-boot.config 扩展，添加
# wireguard + iperf3 + smartdns + passwall 及其依赖
# 注意：CONFIG_VERSIONOPT/VERSION_NUMBER 会被 sync-overlay.sh
# 自动删除并用项目 VERSION 文件重写，写什么都行。
# ============================================================

# ---------------- 基础配置（与 tyfza1-boot.config 一致） ----------------
CONFIG_TARGET_rtl9617c=y
CONFIG_TARGET_rtl9617c_generic=y
CONFIG_TARGET_rtl9617c_generic_DEVICE_tianyi_tyfza1=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_INITRAMFS_COMPRESSION_GZIP=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_TARGZ=y
CONFIG_PACKAGE_ubi-utils=y
CONFIG_PACKAGE_nand-utils=y
CONFIG_PACKAGE_uboot-envtools=y
CONFIG_PACKAGE_kmod-rtl-ax-ap=y
CONFIG_KERNEL_IKCONFIG=y
CONFIG_KERNEL_IKCONFIG_PROC=y
# CONFIG_KERNEL_KALLSYMS_EXTRA_PASS is not set
# CONFIG_TARGET_ROOTFS_EXT4FS is not set
# CONFIG_TARGET_ROOTFS_UBIFS is not set
# CONFIG_SIGNED_PACKAGES is not set
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_luci-app-tyfza1-pon=y
CONFIG_PACKAGE_tyfza1-pon-control=y
CONFIG_PACKAGE_kmod-ipt-offload=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_wpad-mbedtls=y
CONFIG_PACKAGE_wifi-scripts=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_wireless-regdb=y
CONFIG_IMAGEOPT=y
CONFIG_VERSIONOPT=y
CONFIG_VERSION_NUMBER="custom"

# ============================================================
# 新增：WireGuard
# kmod-wireguard 在内核源码包（core），无需额外 feed；
# 若最终 defconfig 提示 kmod-wireguard 不存在（该内核已内置
# WireGuard），删掉这一行即可，不影响使用。
# ============================================================
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y

# ============================================================
# 新增：iperf3 测速（服务端/客户端一体）
# ============================================================
CONFIG_PACKAGE_iperf3=y

# ============================================================
# 新增：SmartDNS
# ============================================================
CONFIG_PACKAGE_smartdns=y
CONFIG_PACKAGE_luci-app-smartdns=y
CONFIG_PACKAGE_luci-i18n-smartdns-zh-cn=y

# ============================================================
# PassWall 及其依赖
# 依赖：dnsmasq-full 与基础 dnsmasq 冲突，必须二选一
# ============================================================
CONFIG_PACKAGE_dnsmasq-full=y
# CONFIG_PACKAGE_dnsmasq is not set
# ip-full 替换默认 ip-tiny，full iproute2 是 PassWall/规则路由依赖
CONFIG_PACKAGE_ip-full=y
# ipset + 内核 ipset 支持（PassWall 按 IP 分流）
CONFIG_PACKAGE_ipset=y
# kmod-tun：Xray/sing-box tun 模式需要
CONFIG_PACKAGE_kmod-tun=y
# kmod-nft-tproxy：fw4/nftables 下的透明代理支持
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_nftables=y

# ---------------- PassWall 核心与 LuCI ----------------
# xray-core 在 passwall_packages feed，是 PassWall 默认的代理核心
CONFIG_PACKAGE_xray-core=y
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-i18n-passwall-zh-cn=y

# ============================================================
# 可选项（按需取消注释）：
# sing-box（体积较大，与 xray 二选一或都装）
# CONFIG_PACKAGE_sing-box=y
# 备用 DNS/代理组件（passwall_packages feed 提供）
# CONFIG_PACKAGE_chinadns-ng=y
# CONFIG_PACKAGE_dns2socks=y
# CONFIG_PACKAGE_shadowsocks-libev=y
# CONFIG_PACKAGE_hysteria=y
# 国际化
# CONFIG_PACKAGE_luci-i18n-samba4-zh-cn=y
# ============================================================
